# Copie para .env.production e preencha antes de buildar para produção.
# Estas chaves são públicas (embutidas no bundle do cliente) e protegidas por RLS.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# ---- Configuração de Edge Functions (secrets do Supabase) ----
# Estas variáveis NÃO entram no bundle do cliente; documentam o que deve ser
# cadastrado em Settings > Edge Functions > Secrets do Supabase.

# IA (endpoint OpenAI-compatible, padrão OpenRouter):
#   AI_API_KEY="sk-or-v1-..."            (obrigatória)
#   AI_BASE_URL="https://openrouter.ai/api/v1"
#   AI_TRANSCRIBE_BASE_URL="https://api.openai.com/v1"
#   AI_TRANSCRIBE_MODEL="gpt-4o-mini-transcribe"
# Brain (OpenCode Zen):
#   OPENCODE_API_KEY="oc-..."

# E-mail transacional (Resend):
#   RESEND_API_KEY="re_..."              (obrigatória)
#   RESEND_WEBHOOK_SECRET="..."          (obrigatória p/ webhooks de bounce/complaint)
#   PUBLIC_BASE_URL="https://evoluacrm.com.br"   (base do link de unsubscribe)
#   EMAIL_SENDER_DOMAIN="notify.appiganhei.com"  (opcional — sobrescreve remetente)
#   EMAIL_FROM_DOMAIN="notify.appiganhei.com"    (opcional — sobrescreve header From)